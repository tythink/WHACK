{
  "name": "whack-vscode",
  "displayName": "WHACK — Live Multimodal Chef's Pass & Brain Assistant",
  "description": "Real-time multimodal developer assistant that watches live facial affect, 3D gaze, cursor thrash, and terminal errors — chiming in with Gordon Ramsay code diagnostics, line highlights, 1-click diff fixes, and live mentoring chat.",
  "version": "0.1.0",
  "publisher": "whack-team",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Debuggers",
    "Programming Languages"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./runtime/extension.js",
  "scripts": {
    "build": "tsc -p ./tsconfig.json",
    "typecheck": "tsc -p ./tsconfig.json --noEmit"
  },
  "contributes": {
    "commands": [
      {
        "command": "whack.togglePanel",
        "title": "WHACK: Open Chef's Pass & Live Mission Control",
        "icon": "$(flame)"
      },
      {
        "command": "whack.startLiveStack",
        "title": "WHACK: Launch Full Live Stack (Brain :5002 + Camera Sensor)",
        "icon": "$(rocket)"
      },
      {
        "command": "whack.stopLiveStack",
        "title": "WHACK: Stop Live Stack",
        "icon": "$(debug-stop)"
      },
      {
        "command": "whack.toggleSensorHud",
        "title": "WHACK: Launch / Close Camera + 3D Gaze Sensor HUD",
        "icon": "$(device-camera)"
      },
      {
        "command": "whack.configureApiKey",
        "title": "WHACK: Set Gemini / OpenAI / Anthropic API Key",
        "icon": "$(key)"
      },
      {
        "command": "whack.triggerDiagnose",
        "title": "WHACK: Diagnose Active Code Now (Ctrl+Shift+K)",
        "icon": "$(pulse)"
      },
      {
        "command": "whack.previewDiff",
        "title": "WHACK: Preview Suggested Fix Diff"
      },
      {
        "command": "whack.applyFix",
        "title": "WHACK: Apply Suggested Fix"
      },
      {
        "command": "whack.jumpToCitation",
        "title": "WHACK: Jump to Cited Code Location"
      },
      {
        "command": "whack.focusChat",
        "title": "WHACK: Ask Follow-Up in Right-Side Chat"
      },
      {
        "command": "whack.dismiss",
        "title": "WHACK: Clear Highlights & Snooze 3m"
      },
      {
        "command": "whack.takeBreak",
        "title": "WHACK: Take 5m Break (Snooze WHACK)"
      },
      {
        "command": "whack.statusMenu",
        "title": "WHACK: Quick Actions Menu"
      },
      {
        "command": "whack.toggleSound",
        "title": "WHACK: Toggle Brain Notification Sound (ON/OFF)"
      }
    ],
    "keybindings": [
      {
        "command": "whack.triggerDiagnose",
        "key": "ctrl+shift+k",
        "mac": "cmd+shift+k"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "whack.togglePanel",
          "group": "navigation@98"
        },
        {
          "command": "whack.triggerDiagnose",
          "group": "navigation@99"
        }
      ]
    },
    "configuration": {
      "title": "WHACK",
      "properties": {
        "whack.coreServerUrl": {
          "type": "string",
          "default": "http://127.0.0.1:3000",
          "description": "Local WHACK Core Server URL (embedded receiver starts automatically if not running)."
        },
        "whack.brainServerUrl": {
          "type": "string",
          "default": "http://127.0.0.1:5002",
          "description": "Role 3 Brain LLM service URL (http://127.0.0.1:5002)."
        },
        "whack.whackRootPath": {
          "type": "string",
          "default": "",
          "description": "Optional path to your local WHACK repository folder (auto-detected from open workspace or ~/Desktop/WHACK when empty)."
        },
        "whack.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Optional Python executable for starting Brain and Camera Sensor (auto-detects Conda whack-face env when empty)."
        },
        "whack.enableNotificationToast": {
          "type": "boolean",
          "default": true,
          "description": "Show an interactive VS Code notification toast when WHACK Brain returns a diagnosis."
        },
        "whack.enableNotificationSound": {
          "type": "boolean",
          "default": true,
          "description": "Play a subtle two-note notification chime when WHACK Brain returns a live diagnosis or applies a fix."
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.5.4"
  }
}
