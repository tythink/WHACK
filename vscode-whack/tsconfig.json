{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "./runtime",
    "rootDir": "./src",
    "typeRoots": [
      "./src/types",
      "../core/node_modules/@types"
    ]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "runtime"]
}
