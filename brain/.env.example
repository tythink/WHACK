# WHACK Brain Service Environment Configuration
# Provider options: gemini, openai, anthropic
LLM_PROVIDER=gemini

# Provider API Keys (populate the one matching LLM_PROVIDER)
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model override (optional; defaults to gemini-2.5-flash, gpt-4o-mini, or claude-3-5-haiku-latest)
LLM_MODEL=gemini-3-flash-preview

# Service and Target Workspace Settings
WHACK_DEMO_REPO=
DEMO_REPO_DIR=
CORE_SERVER_URL=http://localhost:3000
BRAIN_PORT=5002
BRAIN_HOST=0.0.0.0
LLM_TIMEOUT_SECONDS=22.0
MAX_TOOL_TURNS=4
