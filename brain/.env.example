# WHACK Brain Service Environment Configuration
# Provider options: gemini, openai, anthropic
LLM_PROVIDER=gemini

# Provider API Keys (specify the one matching LLM_PROVIDER)
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model override (optional, defaults to provider default e.g. gemini-2.5-flash, gpt-4o-mini)
LLM_MODEL=

# Service and Target Repo Settings
WHACK_DEMO_REPO=
DEMO_REPO_DIR=
CORE_SERVER_URL=
BRAIN_PORT=
BRAIN_HOST=
LLM_TIMEOUT_SECONDS=
MAX_TOOL_TURNS=
